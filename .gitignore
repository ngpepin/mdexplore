# Per-directory user state written next to the user's documents.
# These name private files and can contain note/highlight text, so they must
# never be committed. Patterns are unanchored to match at any depth.
.mdexplore-views.json
.pdfexplore-views.json
.mdexplore.cfg
.pdfexplore.cfg
.mdexplore-test.cfg
.mdexplore-views.json.lock
